{
  "name": "示例：月度采购计划单",
  "version": 1,
  "template": "examples/template.xlsx",
  "output_dir": "输出",
  "output_name": "示例输出_{yy}年{mm}月{dd}.xlsx",
  "tasks": [
    {
      "name": "示例表",
      "source": {
        "dir": "examples",
        "pattern": "source*.xlsx",
        "sheet": 0,
        "header_row": 1,
        "data_start": 2
      },
      "target": {
        "sheet": "示例表",
        "header_row": 2,
        "data_start": 3
      },
      "cells": {
        "A1": "示例医院 {年} 年 {月} 月药品采购计划表"
      },
      "columns": [
        {
          "target": "药品名称",
          "source": "药品名称",
          "transform": "direct"
        },
        {
          "target": "药品编码",
          "source": "医保代码",
          "transform": "direct"
        },
        {
          "target": "项目名称",
          "source": "项目名称",
          "transform": "direct"
        },
        {
          "target": "规格",
          "source": "规格",
          "transform": "direct"
        },
        {
          "target": "单位",
          "source": "包装信息",
          "transform": "after_slash"
        },
        {
          "target": "单价",
          "source": "采购价",
          "transform": "direct"
        },
        {
          "target": "数量",
          "source": "采购数量",
          "transform": "direct"
        },
        {
          "target": "金额",
          "source": "采购金额",
          "transform": "direct"
        },
        {
          "target": "生产厂家",
          "source": "生产企业",
          "transform": "direct"
        }
      ]
    }
  ]
}